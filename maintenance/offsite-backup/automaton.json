{
  "name": "Automaton Off-site Backup",
  "application": {
    "permissions": ["backups:read"],
    "secrets": [
      { "name": "S3_ENDPOINT", "description": "S3-compatible object storage endpoint URL" },
      { "name": "S3_BUCKET", "description": "Bucket for encrypted Automaton backups" },
      { "name": "S3_ACCESS_KEY_ID", "description": "Object storage access key ID" },
      { "name": "S3_SECRET_ACCESS_KEY", "description": "Object storage secret access key" },
      { "name": "API_BASE_URL", "description": "Base URL of this Automaton server's API; keep it owner-managed, not schedule-controlled" },
      { "name": "S3_REGION", "description": "Optional S3 region; defaults to us-east-1" },
      { "name": "S3_PREFIX", "description": "Optional prefix under automaton/<server host>/" }
    ]
  }
}
