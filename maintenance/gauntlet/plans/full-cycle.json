{
  "name": "full-cycle",
  "title": "Full cycle",
  "description": "Install, use, restart, uninstall with deleted data, then install again, with production's limited automaton user. Runs every week.",
  "target": "nu8",
  "wipes": true,
  "repo": "automaton",
  "steps": [
    {
      "name": "Wipe any earlier install",
      "script": "wipe.sh",
      "timeout": 900,
      "repo": "automaton"
    },
    {
      "name": "Install the latest build",
      "script": "install.sh",
      "timeout": 1500,
      "repo": "automaton"
    },
    {
      "name": "Create the administrator and sign the CLI in",
      "script": "admin.sh",
      "timeout": 300,
      "repo": "automaton"
    },
    {
      "name": "Create the limited automaton user",
      "script": "automaton-user.sh",
      "timeout": 120,
      "repo": "automaton"
    },
    {
      "name": "The limited user has only production's sudo",
      "script": "automaton-user-check.sh",
      "timeout": 120,
      "as": "automaton",
      "repo": "automaton"
    },
    {
      "name": "Default apps and permissions",
      "script": "default-apps.sh",
      "timeout": 300,
      "repo": "automaton-apps"
    },
    {
      "name": "Deploy a sample app and run a backup",
      "script": "use.sh",
      "timeout": 900,
      "repo": "automaton"
    },
    {
      "name": "Restart the machine",
      "script": "reboot-check.sh",
      "timeout": 60,
      "repo": "automaton"
    },
    {
      "name": "Wait for the server to come back",
      "script": "wait-api.sh",
      "timeout": 900,
      "repo": "automaton"
    },
    {
      "name": "Log forwarding",
      "script": "logs-check.sh",
      "timeout": 300,
      "repo": "automaton-apps"
    },
    {
      "name": "Uninstall and check nothing is left",
      "script": "uninstall-check.sh",
      "timeout": 900,
      "repo": "automaton"
    },
    {
      "name": "Install again",
      "script": "install.sh",
      "timeout": 1500,
      "repo": "automaton"
    },
    {
      "name": "Create the administrator again",
      "script": "admin.sh",
      "timeout": 300,
      "repo": "automaton"
    },
    {
      "name": "Create the limited automaton user again",
      "script": "automaton-user.sh",
      "timeout": 120,
      "repo": "automaton"
    },
    {
      "name": "The limited user again has only production's sudo",
      "script": "automaton-user-check.sh",
      "timeout": 120,
      "as": "automaton",
      "repo": "automaton"
    },
    {
      "name": "Default apps and permissions again",
      "script": "default-apps.sh",
      "timeout": 300,
      "repo": "automaton-apps"
    }
  ]
}
