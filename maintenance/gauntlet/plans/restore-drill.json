{
  "name": "restore-drill",
  "title": "Restore drill",
  "description": "Downloads the newest off-site backup, restores it on a freshly installed disposable machine with restore.sh, checks health and sign-in, reports the duration, then deletes the key and wipes. Runs every week.",
  "target": "runner-02",
  "wipes": true,
  "repo": "automaton",
  "steps": [
    {
      "name": "Wipe any earlier install",
      "script": "wipe.sh",
      "timeout": 900,
      "repo": "automaton"
    },
    {
      "name": "Install the latest build",
      "script": "install.sh",
      "timeout": 1500,
      "repo": "automaton"
    },
    {
      "name": "Download the newest backup and place the key",
      "script": "drill-download.sh",
      "timeout": 1800,
      "repo": "automaton",
      "env": [
        "DRILL_BACKUP_KEY",
        "DRILL_S3_ACCESS_KEY_ID",
        "DRILL_S3_SECRET_ACCESS_KEY",
        "DRILL_S3_ENDPOINT",
        "DRILL_S3_REGION",
        "DRILL_S3_BUCKET"
      ],
      "continue": true
    },
    {
      "name": "Restore it with restore.sh",
      "script": "drill-restore.sh",
      "timeout": 1800,
      "repo": "automaton",
      "continue": true
    },
    {
      "name": "Check health and sign-in",
      "script": "drill-check.sh",
      "timeout": 900,
      "repo": "automaton",
      "continue": true
    },
    {
      "name": "Delete the backup key",
      "script": "drill-key-delete.sh",
      "timeout": 120,
      "repo": "automaton",
      "continue": true
    },
    {
      "name": "Result and duration",
      "script": "drill-report.sh",
      "timeout": 60,
      "repo": "automaton",
      "continue": true,
      "contains": "RESTORE DRILL: PASS"
    },
    {
      "name": "Wipe the machine",
      "script": "wipe.sh",
      "timeout": 900,
      "repo": "automaton"
    }
  ]
}
