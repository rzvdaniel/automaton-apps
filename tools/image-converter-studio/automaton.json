{
  "name": "Image Converter Studio",
  "summary": "Convert SVG images to PNG in your browser.",
  "description": "Convert SVG images into PNG files directly in your browser.",
  "category": "Tools",
  "application": {
    "build": {
      "image": "node:22-bookworm-slim",
      "command": {
        "executable": "sh",
        "arguments": [
          "-c",
          "npm ci && npm run build"
        ],
        "workingDirectory": "frontend"
      },
      "outputDirectory": "frontend/dist",
      "timeoutSeconds": 900
    },
    "health": {
      "path": "/index.html"
    },
    "isStaticSite": true
  }
}
