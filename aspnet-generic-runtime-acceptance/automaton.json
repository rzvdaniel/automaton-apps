{
  "name": "ASP.NET Core Generic Runtime Acceptance",
  "application": {
    "build": {
      "command": {
        "executable": "dotnet",
        "arguments": [
          "publish",
          "GenericRuntimeAspNet.csproj",
          "-c",
          "Release",
          "-o",
          "out"
        ],
        "workingDirectory": "."
      },
      "outputDirectory": "out",
      "timeoutSeconds": 900
    },
    "runtime": {
      "command": {
        "executable": "dotnet",
        "arguments": [
          "out/GenericRuntimeAspNet.dll"
        ],
        "workingDirectory": ".",
        "environment": {
          "ACCEPTANCE_VERSION": "v1"
        }
      },
      "port": 8080
    },
    "health": {
      "path": "/health",
      "startupTimeoutSeconds": 60
    },
    "storage": {
      "dataDirectory": "data",
      "mounts": []
    }
  }
}
