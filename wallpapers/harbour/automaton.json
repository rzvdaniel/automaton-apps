{
  "name": "Harbour Wallpaper",
  "summary": "A living harbour island for your desktop that reacts to clicks: the sea, the sheep, the boats and the church bell.",
  "application": {
    "build": {
      "image": "node:22-bookworm-slim",
      "command": {
        "executable": "sh",
        "arguments": [
          "-c",
          "node --check server.js && mkdir -p dist && cp -r server.js public dist/"
        ],
        "workingDirectory": "."
      },
      "outputDirectory": "dist",
      "timeoutSeconds": 300
    },
    "runtime": {
      "image": "node:22-bookworm-slim",
      "user": "1000:1000",
      "command": {
        "executable": "node",
        "arguments": [
          "server.js"
        ],
        "workingDirectory": "dist",
        "environment": {},
        "useShell": false
      },
      "port": 8080
    },
    "health": {
      "path": "/health",
      "startupTimeoutSeconds": 60
    },
    "storage": {
      "dataDirectory": "data",
      "mounts": []
    },
    "kind": "web",
    "description": "A living harbour island for your desktop. Click the sea, the sheep, the boats and the church bell.",
    "pages": [
      {
        "path": "/",
        "label": "Harbour"
      }
    ],
    "secrets": [],
    "permissions": [],
    "openPaths": [],
    "settings": [],
    "schedules": [],
    "isStaticSite": false
  }
}
