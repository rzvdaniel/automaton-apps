{
  "name": "Island Wallpaper",
  "application": {
    "build": {
      "singlePageApp": false,
      "timeoutSeconds": 900
    },
    "runtime": {
      "image": "node:22-bookworm-slim",
      "command": {
        "executable": "node",
        "arguments": [
          "server.js"
        ],
        "workingDirectory": ".",
        "environment": {},
        "useShell": false
      },
      "port": 8080
    },
    "health": {
      "path": "/health",
      "startupTimeoutSeconds": 60
    },
    "storage": {
      "dataDirectory": "data",
      "mounts": []
    },
    "kind": "web",
    "description": "A living island for your desktop. Click the sea to make waves, scare the fish and wake the island.",
    "pages": [
      {
        "path": "/",
        "label": "Island"
      }
    ],
    "secrets": [],
    "permissions": [],
    "openPaths": [],
    "settings": [],
    "schedules": [],
    "isStaticSite": false
  }
}